# Cross file: aarch64-linux-gnu (glibc) target build of Mesa.
#
# Used to compile-verify the freedreno a5xx Vulkan driver against the real
# target architecture. Not intended for producing a distributable build --
# the device build happens on the phone itself.
#
# Prerequisites on the host:
#   gcc-aarch64-linux-gnu g++-aarch64-linux-gnu
#   plus aarch64 equivalents of libdrm-dev, libelf-dev, libexpat1-dev, zlib1g-dev

[binaries]
c = 'aarch64-linux-gnu-gcc'
cpp = 'aarch64-linux-gnu-g++'
ar = 'aarch64-linux-gnu-ar'
strip = 'aarch64-linux-gnu-strip'
# native pkg-config, pointed at the aarch64 sysroot via the env vars set below
pkg-config = 'pkg-config'

[properties]
# Do NOT pass --sysroot: the aarch64-linux-gnu-* drivers already know their own
# sysroot. Passing it additionally breaks meson's library probes (e.g. 'rt'),
# because the linker then ignores its built-in search paths.
needs_exe_wrapper = true
pkg_config_libdir = '/usr/lib/aarch64-linux-gnu/pkgconfig:/usr/share/pkgconfig'

[host_machine]
system = 'linux'
cpu_family = 'aarch64'
cpu = 'aarch64'
endian = 'little'